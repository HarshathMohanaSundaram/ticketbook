<% content_for :title, "Reschedule #{@booking.pnr}" %>

<div class="mx-auto max-w-3xl">
  <%= link_to "&larr; Back to ticket".html_safe, @booking, class: "text-sm text-slate-600 underline" %>

  <h1 class="mt-3 text-2xl font-semibold tracking-tight">Move to another departure</h1>
  <p class="mt-1 text-sm text-slate-600">
    <%= @booking.trip.operator_name %> &middot;
    <%= @booking.trip.origin_city.name %> &rarr; <%= @booking.trip.destination_city.name %> &middot;
    currently <%= l @booking.departs_at, format: :day_and_time %> &middot;
    <%= pluralize(@booking.tickets.count, "seat") %>
  </p>

  <% if @alternatives.empty? %>
    <p class="mt-4 rounded-lg border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-slate-500">
      No other <%= @booking.trip.operator_name %> departures on this route are open for booking.
    </p>
  <% else %>
    <h2 class="mt-6 text-sm font-semibold text-slate-700">Pick a departure</h2>
    <div class="mt-2 space-y-2">
      <% @alternatives.each do |trip| %>
        <% selected = @target_trip&.id == trip.id %>
        <%= link_to new_booking_reschedule_path(@booking, trip_id: trip.id),
              class: "flex flex-wrap items-center justify-between gap-3 rounded-lg border bg-white px-4 py-3 shadow-sm
                      #{selected ? 'border-slate-900 ring-1 ring-slate-900' : 'border-slate-200 hover:border-slate-400'}" do %>
          <div>
            <p class="font-medium"><%= l trip.departs_at, format: :day_and_time %></p>
            <p class="text-sm text-slate-600">
              <%= trip.bus.label %> &middot; arrives <%= l trip.arrives_at, format: :time_of_day %>
            </p>
          </div>
          <div class="text-right text-sm">
            <p class="font-semibold"><%= number_to_currency(trip.base_fare_paise / 100.0, unit: "&#8377;".html_safe, precision: 0) %></p>
            <% difference = trip.base_fare_paise - (@booking.total_paise / @booking.tickets.count) %>
            <p class="text-xs <%= difference.positive? ? 'text-amber-700' : 'text-emerald-700' %>">
              <%= difference.zero? ? "same fare" : "#{difference.positive? ? '+' : '-'}#{number_to_currency(difference.abs / 100.0, unit: '₹', precision: 0)} per seat" %>
            </p>
          </div>
        <% end %>
      <% end %>
    </div>

    <% if @target_trip %>
      <h2 class="mt-8 text-sm font-semibold text-slate-700">
        Pick <%= pluralize(@booking.tickets.count, "seat") %> on the
        <%= l @target_trip.departs_at, format: :time_of_day %> departure
      </h2>
      <%= render "reschedules/seat_picker", booking: @booking, trip: @target_trip, seats: @seats %>
    <% end %>
  <% end %>
</div>
