<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Ticketbook" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
        <%= link_to root_path, class: "text-lg font-semibold tracking-tight" do %>
          <span aria-hidden="true">&#128652;</span> Ticketbook
        <% end %>

        <div class="flex items-center gap-3 text-sm">
          <% if signed_in? %>
            <span class="text-slate-600"><%= current_user.email %></span>
            <%= button_to "Sign out", session_path, method: :delete,
                  class: "rounded-md border border-slate-300 px-3 py-1.5 font-medium hover:bg-slate-100" %>
          <% else %>
            <%= link_to "Sign in", new_session_path,
                  class: "rounded-md bg-slate-900 px-3 py-1.5 font-medium text-white hover:bg-slate-700" %>
          <% end %>
        </div>
      </div>
    </header>

    <% if notice.present? || alert.present? %>
      <div class="mx-auto max-w-5xl px-4 pt-4">
        <% if notice.present? %>
          <p class="rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900" role="status"><%= notice %></p>
        <% end %>
        <% if alert.present? %>
          <p class="rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="alert"><%= alert %></p>
        <% end %>
      </div>
    <% end %>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
