<% content_for :title, "Confirm your booking" %>

<div class="mx-auto max-w-2xl">
  <div class="rounded-lg border border-amber-200 bg-amber-50 px-5 py-3"
       data-controller="hold-countdown"
       data-hold-countdown-expires-at-value="<%= @hold.expires_at.iso8601 %>">
    <p class="text-sm text-amber-900">
      Confirm within
      <span class="font-mono text-base font-semibold" data-hold-countdown-target="clock" aria-live="polite">
        <%= Time.at(@hold.seconds_remaining).utc.strftime("%-M:%S") %>
      </span>
      or your seats go back on sale.
    </p>
  </div>

  <%= form_with url: hold_booking_path(@hold), method: :post,
        class: "mt-4 rounded-lg border border-slate-200 bg-white p-5 shadow-sm" do %>

    <h1 class="font-semibold"><%= @trip.operator_name %></h1>
    <p class="mt-1 text-sm text-slate-600">
      <%= @trip.origin_city.name %> &rarr; <%= @trip.destination_city.name %> &middot;
      <%= l @trip.departs_at, format: :time_of_day %>, <%= @trip.departs_at.strftime("%-d %b") %> &middot;
      <%= @trip.bus.label %>
    </p>

    <h2 class="mt-6 text-sm font-semibold text-slate-700">Passengers</h2>
    <div class="mt-2 space-y-3">
      <% @seats.each_with_index do |seat, index| %>
        <div class="grid gap-2 sm:grid-cols-[4rem_1fr_5rem_7rem] sm:items-end">
          <span class="rounded bg-slate-100 px-2 py-2 text-center text-sm font-medium"><%= seat.seat_number %></span>

          <div>
            <%= label_tag "passengers_#{index}_name", "Full name", class: "block text-xs text-slate-500" %>
            <%= text_field_tag "passengers[#{index}][name]", (current_user.name if index.zero?),
                  id: "passengers_#{index}_name", required: true, placeholder: "As on ID",
                  class: "mt-0.5 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>

          <div>
            <%= label_tag "passengers_#{index}_age", "Age", class: "block text-xs text-slate-500" %>
            <%= number_field_tag "passengers[#{index}][age]", nil, min: 1, max: 119,
                  id: "passengers_#{index}_age",
                  class: "mt-0.5 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>

          <div>
            <%= label_tag "passengers_#{index}_gender", "Gender", class: "block text-xs text-slate-500" %>
            <%= select_tag "passengers[#{index}][gender]",
                  options_for_select([ %w[Male male], %w[Female female], %w[Other other] ]),
                  include_blank: "-", id: "passengers_#{index}_gender",
                  class: "mt-0.5 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>
        </div>
      <% end %>
    </div>

    <h2 class="mt-6 text-sm font-semibold text-slate-700">Pickup and drop</h2>
    <div class="mt-2 grid gap-3 sm:grid-cols-2">
      <div>
        <%= label_tag :boarding_stop_id, "Boarding point", class: "block text-xs text-slate-500" %>
        <%= select_tag :boarding_stop_id,
              options_from_collection_for_select(@trip.boarding_stops, :id, :label),
              required: true, class: "mt-0.5 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= label_tag :dropping_stop_id, "Dropping point", class: "block text-xs text-slate-500" %>
        <%= select_tag :dropping_stop_id,
              options_from_collection_for_select(@trip.dropping_stops, :id, :label),
              required: true, class: "mt-0.5 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
      <p class="text-sm text-slate-600">
        <%= pluralize(@seats.size, "seat") %> &middot; total
        <span class="text-base font-semibold text-slate-900">
          <%= number_to_currency(@hold.total_paise / 100.0, unit: "&#8377;".html_safe, precision: 0) %>
        </span>
      </p>
      <%= submit_tag "Confirm booking",
            class: "cursor-pointer rounded-md bg-slate-900 px-6 py-2 font-medium text-white hover:bg-slate-700" %>
    </div>
  <% end %>
</div>
