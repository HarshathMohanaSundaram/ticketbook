<% content_for :title, "My bookings" %>

<h1 class="text-2xl font-semibold tracking-tight">My bookings</h1>

<% if @bookings.any? %>
  <div class="mt-4 space-y-3">
    <% @bookings.each do |booking| %>
      <%= link_to booking, class: "block rounded-lg border border-slate-200 bg-white p-4 shadow-sm hover:border-slate-400" do %>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="font-medium">
              <%= booking.trip.origin_city.name %> &rarr; <%= booking.trip.destination_city.name %>
            </p>
            <p class="mt-0.5 text-sm text-slate-600">
              <%= booking.trip.operator_name %> &middot;
              <%= l booking.departs_at, format: :time_of_day %>, <%= booking.departs_at.strftime("%-d %b") %> &middot;
              <%= pluralize(booking.tickets.size, "seat") %>
            </p>
          </div>
          <div class="text-right">
            <p class="font-mono text-sm font-semibold tracking-wider"><%= booking.pnr %></p>
            <span class="text-xs <%= booking.confirmed? ? 'text-emerald-700' : 'text-slate-500' %>">
              <%= booking.status.humanize %>
            </span>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="mt-4 rounded-lg border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-slate-500">
    No bookings yet. <%= link_to "Find a bus", trips_path, class: "underline" %>.
  </p>
<% end %>
