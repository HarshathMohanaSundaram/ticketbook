<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-md">
  <h1 class="text-2xl font-semibold tracking-tight">Sign in</h1>
  <p class="mt-2 text-sm text-slate-600">
    Enter your email and we will send you a sign-in link. No password needed --
    if you have not booked with us before, this creates your account.
  </p>

  <%= form_with url: session_path, method: :post, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email, "Email address", class: "block text-sm font-medium" %>
      <%= form.email_field :email, required: true, autofocus: true,
            autocomplete: "email", placeholder: "you@example.com",
            class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>
    </div>

    <%= form.submit "Email me a sign-in link",
          class: "w-full cursor-pointer rounded-md bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-700" %>
  <% end %>

  <% if Rails.env.development? %>
    <p class="mt-6 border-t border-slate-200 pt-4 text-xs text-slate-500">
      Development: mail is not actually sent.
      <%= link_to "Open the inbox", "/letter_opener", class: "underline" %> to click your link.
    </p>
  <% end %>
</div>
