<details class="mt-4 border-t border-slate-200 pt-3" <%= "open" if @form.filters_applied? %>>
  <summary class="cursor-pointer text-sm font-medium text-slate-700">
    Filters<%= " (#{@form.filter_count})" if @form.filters_applied? %>
  </summary>

  <div class="mt-4 grid gap-4 sm:grid-cols-4">
    <div>
      <%= form.label :bus_type, "Bus type", class: "block text-sm font-medium" %>
      <%= form.select :bus_type,
            options_for_select([ [ "AC", "ac" ], [ "Non-AC", "non_ac" ] ], @form.bus_type),
            { include_blank: "Any" },
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= form.label :berth_type, "Seating", class: "block text-sm font-medium" %>
      <%= form.select :berth_type,
            options_for_select([ [ "Sleeper", "sleeper" ], [ "Seater", "seater" ] ], @form.berth_type),
            { include_blank: "Any" },
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= form.label :min_rating, "Minimum rating", class: "block text-sm font-medium" %>
      <%= form.select :min_rating,
            options_for_select([ [ "4.5+", "4.5" ], [ "4.0+", "4.0" ], [ "3.5+", "3.5" ], [ "3.0+", "3.0" ] ],
                               @form.min_rating&.to_s),
            { include_blank: "Any" },
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= form.label :sort, "Sort by", class: "block text-sm font-medium" %>
      <%= form.select :sort, options_for_select(TripSearchForm::SORTS.invert.to_a, @form.sort), {},
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>

    <div class="sm:col-span-2">
      <span class="block text-sm font-medium">Fare range (&#8377;)</span>
      <div class="mt-1 flex items-center gap-2">
        <%= form.number_field :min_price, value: @form.min_price, min: 0, step: 50, placeholder: "Min",
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        <span class="text-slate-400">to</span>
        <%= form.number_field :max_price, value: @form.max_price, min: 0, step: 50, placeholder: "Max",
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
    </div>

    <div class="sm:col-span-2">
      <span class="block text-sm font-medium">Amenities</span>
      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
        <% Bus::AMENITY_CODES.each do |code| %>
          <label class="flex items-center gap-1.5 text-sm">
            <%= check_box_tag "amenities[]", code, @form.amenities.include?(code),
                  id: "amenity_#{code}", class: "rounded border-slate-300" %>
            <%= code.humanize %>
          </label>
        <% end %>
      </div>
    </div>
  </div>
</details>
