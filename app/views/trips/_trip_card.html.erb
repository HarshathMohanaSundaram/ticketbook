<% seats_left = available_counts.fetch(trip.id, 0) %>

<article class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <h3 class="font-semibold"><%= trip.operator_name %></h3>
        <span class="rounded bg-emerald-50 px-1.5 py-0.5 text-xs font-medium text-emerald-800">
          <%= number_with_precision(trip.operator_rating, precision: 1) %> &#9733;
        </span>
      </div>
      <p class="mt-0.5 text-sm text-slate-600"><%= trip.bus.label %></p>
    </div>

    <div class="flex items-center gap-6 text-sm">
      <div class="text-center">
        <p class="text-lg font-semibold"><%= l trip.departs_at, format: :time_of_day %></p>
        <p class="text-slate-500"><%= trip.origin_city.name %></p>
      </div>
      <div class="text-center text-xs text-slate-500">
        <p><%= distance_of_time_in_words(trip.departs_at, trip.arrives_at) %></p>
        <div class="my-1 h-px w-16 bg-slate-300"></div>
        <p>direct</p>
      </div>
      <div class="text-center">
        <p class="text-lg font-semibold"><%= l trip.arrives_at, format: :time_of_day %></p>
        <p class="text-slate-500"><%= trip.destination_city.name %></p>
      </div>
    </div>

    <div class="text-right">
      <p class="text-lg font-semibold"><%= number_to_currency(trip.base_fare_paise / 100.0, unit: "&#8377;".html_safe, precision: 0) %></p>
      <p class="mt-0.5 text-xs <%= seats_left.zero? ? 'text-red-600' : 'text-slate-500' %>">
        <%= seats_left.zero? ? "Sold out" : "#{seats_left} seats left" %>
      </p>
      <% if seats_left.positive? %>
        <%= link_to "View seats", trip_path(trip),
              class: "mt-2 inline-block rounded-md bg-slate-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-slate-700" %>
      <% else %>
        <span class="mt-2 inline-block cursor-not-allowed rounded-md bg-slate-200 px-4 py-1.5 text-sm font-medium text-slate-500">
          Sold out
        </span>
      <% end %>
    </div>
  </div>

  <% if trip.amenity_codes.any? %>
    <ul class="mt-3 flex flex-wrap gap-1.5 border-t border-slate-100 pt-3">
      <% trip.amenity_codes.each do |code| %>
        <li class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-700"><%= code.humanize %></li>
      <% end %>
    </ul>
  <% end %>
</article>
