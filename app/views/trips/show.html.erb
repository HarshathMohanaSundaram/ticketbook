<% content_for :title, "#{@trip.operator_name}: #{@trip.origin_city.name} to #{@trip.destination_city.name}" %>

<%= link_to "&larr; Back to search".html_safe, trips_path(from: @trip.origin_city.slug,
      to: @trip.destination_city.slug, date: @trip.service_date), class: "text-sm text-slate-600 underline" %>

<div class="mt-4 rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-xl font-semibold"><%= @trip.operator_name %></h1>
      <p class="mt-1 text-sm text-slate-600">
        <%= @trip.bus.label %> &middot;
        <%= number_with_precision(@trip.operator_rating, precision: 1) %> &#9733; &middot;
        <%= @trip.bus.registration_number %>
      </p>
    </div>
    <div class="text-right">
      <p class="text-xl font-semibold"><%= number_to_currency(@trip.base_fare_paise / 100.0, unit: "&#8377;".html_safe, precision: 0) %></p>
      <p class="text-xs text-slate-500"><%= @available_count %> of <%= @trip.seats_total %> seats available</p>
    </div>
  </div>

  <div class="mt-5 grid gap-5 sm:grid-cols-2">
    <div>
      <h2 class="text-sm font-medium text-slate-700">Boarding points</h2>
      <ul class="mt-2 space-y-1 text-sm text-slate-600">
        <% @trip.boarding_stops.each do |stop| %>
          <li><span class="font-medium text-slate-900"><%= stop.scheduled_time %></span> &middot; <%= stop.full_name %></li>
        <% end %>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-medium text-slate-700">Dropping points</h2>
      <ul class="mt-2 space-y-1 text-sm text-slate-600">
        <% @trip.dropping_stops.each do |stop| %>
          <li><span class="font-medium text-slate-900"><%= stop.scheduled_time %></span> &middot; <%= stop.full_name %></li>
        <% end %>
      </ul>
    </div>
  </div>

  <% if @trip.amenity_codes.any? %>
    <ul class="mt-5 flex flex-wrap gap-1.5 border-t border-slate-100 pt-4">
      <% @trip.amenity_codes.each do |code| %>
        <li class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-700"><%= code.humanize %></li>
      <% end %>
    </ul>
  <% end %>
</div>

<p class="mt-4 rounded-lg border border-dashed border-slate-300 bg-white px-6 py-10 text-center text-sm text-slate-500">
  Seat selection lands here next.
</p>
