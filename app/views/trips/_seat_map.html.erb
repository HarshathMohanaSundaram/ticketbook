<%# Seats grouped into rows: decks for a sleeper, rows of four for a seater. %>
<% rows = trip.bus.sleeper? ? seats.group_by { |s| s.seat_number[0] } : seats.group_by { |s| s.seat_number.to_i }.sort.to_h %>

<div class="mt-4 rounded-lg border border-slate-200 bg-white p-5 shadow-sm"
     data-controller="seat-selection"
     data-seat-selection-max-seats-value="<%= Hold::MAX_SEATS %>">

  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="font-semibold">Pick your seats</h2>
    <ul class="flex flex-wrap gap-3 text-xs text-slate-600">
      <li class="flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded border border-emerald-600 bg-emerald-50"></span>Available</li>
      <li class="flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded border border-slate-900 bg-slate-900"></span>Selected</li>
      <li class="flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded border border-slate-300 bg-slate-200"></span>Unavailable</li>
    </ul>
  </div>

  <%= form_with url: trip_holds_path(trip), method: :post, class: "mt-4" do |form| %>
    <%= hidden_field_tag :seat_ids, "", data: { seat_selection_target: "input" } %>

    <div class="space-y-2 overflow-x-auto">
      <% rows.each do |label, row_seats| %>
        <div class="flex items-center gap-2">
          <span class="w-6 shrink-0 text-xs font-medium text-slate-400"><%= label %></span>
          <% row_seats.sort_by { |s| [ s.seat_number.length, s.seat_number ] }.each do |seat| %>
            <% claimable = seat.claimable? %>
            <button type="button"
                    data-seat-selection-target="seat"
                    data-action="click->seat-selection#toggle"
                    data-seat-id="<%= seat.id %>"
                    data-seat-number="<%= seat.seat_number %>"
                    data-price="<%= seat.price_paise %>"
                    <%= "disabled" unless claimable %>
                    aria-pressed="false"
                    aria-label="Seat <%= seat.seat_number %><%= claimable ? "" : ", unavailable" %>"
                    class="h-10 w-12 shrink-0 rounded border text-xs font-medium transition
                           <%= claimable ? 'border-emerald-600 bg-emerald-50 text-emerald-900 hover:bg-emerald-100 cursor-pointer aria-pressed:border-slate-900 aria-pressed:bg-slate-900 aria-pressed:text-white'
                                         : 'cursor-not-allowed border-slate-300 bg-slate-200 text-slate-400' %>">
              <%= seat.seat_number %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <p class="invisible mt-4 text-sm font-medium text-red-600" role="alert"
       data-seat-selection-target="notice">&nbsp;</p>

    <div class="mt-1 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
      <p class="text-sm text-slate-600">
        <span data-seat-selection-target="count">0</span> selected
        &middot; total <span class="font-semibold text-slate-900" data-seat-selection-target="total">&#8377;0</span>
      </p>

      <% if signed_in? %>
        <%= form.submit "Hold seats for 5 minutes", disabled: true,
              data: { seat_selection_target: "submit" },
              class: "cursor-pointer rounded-md bg-slate-900 px-5 py-2 font-medium text-white hover:bg-slate-700 disabled:cursor-not-allowed disabled:bg-slate-300" %>
      <% else %>
        <%= link_to "Sign in to book", new_session_path,
              class: "rounded-md bg-slate-900 px-5 py-2 font-medium text-white hover:bg-slate-700" %>
      <% end %>
    </div>
  <% end %>
</div>
